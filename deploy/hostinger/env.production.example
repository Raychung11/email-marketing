# ---------------------------------------------------------------------------
# Hostinger shared hosting — production .env
#
# Copy this to the application root as .env, then fill in the four values
# marked CHANGE ME. Nothing else needs editing to get a working install.
#
#   cp deploy/hostinger/env.production.example .env
#   nano .env
#   php cron/console.php key:generate
#
# This file is a template and is committed. The real .env is not, and must
# never be: it holds the database password and the key that decrypts every
# stored credential.
# ---------------------------------------------------------------------------

APP_NAME="AI Growth Hub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://steelblue-mule-213168.hostingersite.com
# Leave APP_KEY empty here. `php cron/console.php key:generate` writes it.
# Changing it later makes every stored API key undecryptable.
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=en

# ---------------------------------------------------------------------------
# The legal entity behind this deployment.
#
# Shown in the public site footer. Leave empty and the footer omits it.
# This is NOT the postal address that goes in your email footers — that is per
# organisation and lives in Settings → Brand, because each tenant has its own.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME=
COMPANY_REGISTRATION_NO=
COMPANY_ADDRESS=

# ---------------------------------------------------------------------------
# Database — hPanel → Databases → Management
# ---------------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u822252863_smartemail
DB_USERNAME=                       # CHANGE ME — the u822252863_… user, not your hPanel login
DB_PASSWORD=                       # CHANGE ME — the database user's password
DB_CHARSET=utf8mb4
# Hostinger shared hosting runs MariaDB, which has never had utf8mb4_0900_ai_ci.
# Leave this alone unless you have moved to a real MySQL 8 server.
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# Queue — there is no Redis on shared hosting, so the queue lives in the
# database and cron drives the worker. See deploy/hostinger/cron.txt.
# ---------------------------------------------------------------------------
QUEUE_DRIVER=database
QUEUE_CAMPAIGN=email_marketing

# ---------------------------------------------------------------------------
# Session & security — all four of these matter on a live domain
# ---------------------------------------------------------------------------
SESSION_NAME=aigh_session
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_SAMESITE=Lax
FORCE_HTTPS=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900
PASSWORD_RESET_TTL=3600

# ---------------------------------------------------------------------------
# Mail
#
# Starts on `log`, which writes what would have been sent to
# storage/logs/app.log and sends nothing. Leave it there until your sending
# domain is verified — a first campaign from an unverified domain is how a
# new SES account gets suspended.
#
# When SES is ready: set MAIL_PROVIDER=ses and fill in the AWS values.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=log
MAIL_FROM_ADDRESS=no-reply@example.com    # CHANGE ME — must be on a domain you verified
MAIL_FROM_NAME="AI Growth Hub"

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=
AWS_SES_SNS_TOPIC_ARN=

MAIL_RATE_PER_SECOND=14

# ---------------------------------------------------------------------------
# AI — `null` until you add a key. Every AI screen degrades to a plain form
# rather than erroring, so this is safe to leave empty.
# ---------------------------------------------------------------------------
AI_PROVIDER=null
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60
AI_MONTHLY_TOKEN_CAP=2000000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_ROOT=storage/uploads

# ---------------------------------------------------------------------------
# Anti-abuse defaults
# ---------------------------------------------------------------------------
SENDING_LIMIT_NEW_DAILY=500
SENDING_LIMIT_VERIFIED_DAILY=5000
BOUNCE_RATE_ALERT=0.05
COMPLAINT_RATE_ALERT=0.001

ATTRIBUTION_MODEL=last_click
ATTRIBUTION_WINDOW_DAYS=30

LOG_LEVEL=warning
LOG_PATH=storage/logs/app.log

SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_CONFIRM_ABOVE=25
