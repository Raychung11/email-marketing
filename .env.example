# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI Growth Hub"
APP_ENV=local                      # local | staging | production
APP_DEBUG=true                     # MUST be false in production
APP_URL=http://localhost:8000
# Generate with: php cron/console.php key:generate
APP_KEY=
APP_TIMEZONE=UTC                   # Storage timezone. Always UTC. Display uses org timezone.
APP_LOCALE=en

# ---------------------------------------------------------------------------
# The legal entity behind this deployment.
#
# Shown in the public site footer. Leave empty and the footer omits it.
# This is NOT the postal address that goes in your email footers — that is per
# organisation and lives in Settings → Brand, because each tenant has its own.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME=
COMPANY_REGISTRATION_NO=
COMPANY_ADDRESS=

# ---------------------------------------------------------------------------
# Database (MySQL 8+)
# ---------------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_growth_hub
DB_USERNAME=ai_growth_hub
DB_PASSWORD=
DB_CHARSET=utf8mb4
# utf8mb4_unicode_ci works on MySQL 5.7/8 and MariaDB.
# On MySQL 8 specifically you can use utf8mb4_0900_ai_ci instead.
# MariaDB does not have that collation and will refuse every CREATE TABLE.
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# Redis (queue, cache, rate limiting, scheduler locks)
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_DRIVER=redis                 # redis | database | sync (sync = tests only)
QUEUE_CAMPAIGN=email_marketing     # queue campaign sends land on

# ---------------------------------------------------------------------------
# Session & security
# ---------------------------------------------------------------------------
SESSION_NAME=aigh_session
SESSION_LIFETIME=7200              # seconds
SESSION_SECURE=false               # true in production (TLS only)
SESSION_SAMESITE=Lax
FORCE_HTTPS=false                  # true in production
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900
PASSWORD_RESET_TTL=3600

# ---------------------------------------------------------------------------
# Mail — provider is interchangeable (see App\Mail\EmailProviderInterface)
# ---------------------------------------------------------------------------
MAIL_PROVIDER=ses                  # ses | sendgrid | brevo | mailgun | log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="AI Growth Hub"

# Amazon SES
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=
AWS_SES_SNS_TOPIC_ARN=

# Fallback send rate, used only when the provider does not report a live quota.
# The real limit is read from getQuota() at dispatch time.
MAIL_RATE_PER_SECOND=14

# ---------------------------------------------------------------------------
# AI — provider is interchangeable (see App\AI\AiProviderInterface)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai                 # openai | null
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60
AI_MONTHLY_TOKEN_CAP=2000000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local               # local | s3 (s3 in a later phase)
STORAGE_ROOT=storage/uploads
S3_BUCKET=
S3_REGION=

# ---------------------------------------------------------------------------
# Anti-abuse defaults (per organisation; overridable in super admin)
# ---------------------------------------------------------------------------
SENDING_LIMIT_NEW_DAILY=500
SENDING_LIMIT_VERIFIED_DAILY=5000
BOUNCE_RATE_ALERT=0.05
COMPLAINT_RATE_ALERT=0.001

# ---------------------------------------------------------------------------
# Attribution
# ---------------------------------------------------------------------------
ATTRIBUTION_MODEL=last_click       # last_click | first_click | influenced
ATTRIBUTION_WINDOW_DAYS=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info                     # debug | info | warning | error
LOG_PATH=storage/logs/app.log

# ---------------------------------------------------------------- text messages
SMS_PROVIDER=log                   # twilio | log (log = nothing actually sends)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Ask for confirmation before a send costing more than this.
SMS_CONFIRM_ABOVE=25
